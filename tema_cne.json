{
  "name": "CNE Combustibles",
  "dataColors": ["#1F3A5F", "#3A7CA5", "#81C3D7", "#F2A541", "#6C757D", "#B8C4CE", "#1A9850", "#D73027"],
  "background": "#FFFFFF",
  "foreground": "#1F2933",
  "tableAccent": "#1F3A5F",
  "good": "#1A9850",
  "neutral": "#D9D9D9",
  "bad": "#D73027",
  "minimum": "#1A9850",
  "center": "#D9D9D9",
  "maximum": "#D73027",
  "textClasses": {
    "callout": { "fontFace": "Segoe UI Semibold", "fontSize": 26, "color": "#1F2933" },
    "title": { "fontFace": "Segoe UI Semibold", "fontSize": 12, "color": "#1F2933" },
    "header": { "fontFace": "Segoe UI Semibold", "fontSize": 11, "color": "#1F2933" },
    "label": { "fontFace": "Segoe UI", "fontSize": 10, "color": "#52606D" }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [{ "show": true, "color": { "solid": { "color": "#FFFFFF" } }, "transparency": 0 }],
        "border": [{ "show": true, "color": { "solid": { "color": "#E4E7EB" } }, "radius": 8 }],
        "dropShadow": [{ "show": false }],
        "title": [{ "fontColor": { "solid": { "color": "#1F2933" } }, "fontSize": 12, "fontFamily": "Segoe UI Semibold" }]
      }
    },
    "page": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#F3F5F7" } }, "transparency": 0 }],
        "outspace": [{ "color": { "solid": { "color": "#F3F5F7" } }, "transparency": 0 }]
      }
    }
  }
}
